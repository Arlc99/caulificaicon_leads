# ─── Servidor (NUNCA llevan prefijo VITE_: no se exponen al navegador) ───
# API key de Groq: https://console.groq.com/keys
GROQ_API_KEY=tu_api_key
# Modelo de Groq (opcional; debe soportar json_schema estricto)
GROQ_MODEL=openai/gpt-oss-120b
# URL del despliegue web de Google Apps Script (termina en /exec)
GOOGLE_SHEETS_WEBHOOK_URL=tu_webhook_url
# Secreto compartido con Apps Script (opcional pero recomendado; mismo valor en Propiedades del script → WEBHOOK_SECRET)
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Orígenes permitidos separados por coma (opcional; vacío = sin restricción)
ALLOWED_ORIGINS=

# ─── Cliente (públicas: se incluyen en el bundle) ───
# WhatsApp comercial en formato internacional sin "+" ni espacios (ej. 573001234567)
VITE_COMPANY_WHATSAPP=
# URL del logotipo oficial (opcional; si está vacío se usa el monograma de texto)
VITE_BRAND_LOGO_URL=
